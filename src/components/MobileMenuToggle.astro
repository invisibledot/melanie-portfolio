---
<div class="md:hidden">

  <!-- Hamburger Button -->
  <button id="mobile-button" class="text-2xl z-20 relative" aria-label="Toggle Menu">☰</button>

  <!-- Mobile Menu (full-width overlay) -->
  <div
    id="mobile-menu"
    class="hidden fixed top-0 left-0 w-screen h-screen bg-white z-10 flex flex-col pt-24 px-6"
  >
    <nav class="flex flex-col gap-6 text-lg font-medium">
      <a href="/" class="hover:opacity-60 transition">Work</a>
      <a href="/comics" class="hover:opacity-60 transition">Comics</a>
      <a href="/about" class="hover:opacity-60 transition">About</a>
    </nav>
  </div>

</div>

<script client:load>
  const button = document.getElementById('mobile-button');
  const menu = document.getElementById('mobile-menu');

  button.addEventListener('click', () => {
    menu.classList.toggle('hidden');
  });
</script>