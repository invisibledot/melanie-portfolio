---
<div class="md:hidden relative" client:idle>

  <button class="hamburger text-2xl z-20 relative" aria-label="Toggle Menu">
    ☰
  </button>

  <div class="mobile-menu hidden fixed top-0 left-0 w-screen h-screen bg-white z-10 flex flex-col pt-24 px-6">
    <nav class="flex flex-col gap-6 text-lg font-medium">
      <a href="/" class="hover:opacity-60 transition">Work</a>
      <a href="/comics" class="hover:opacity-60 transition">Comics</a>
      <a href="/about" class="hover:opacity-60 transition">About</a>
    </nav>
  </div>

</div>

<script>
  const container = document.currentScript.parentElement;
  const button = container.querySelector('.hamburger');
  const menu = container.querySelector('.mobile-menu');

  button.addEventListener('click', () => {
    menu.classList.toggle('hidden');
  });
</script>