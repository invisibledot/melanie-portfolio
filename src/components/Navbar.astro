---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
---

<nav class="fixed top-0 left-0 w-full z-50 bg-white border-b border-spot-dark">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Brand -->
    <div class="flex-shrink-0 flex items-center">
      <a href="/" class="flex items-center">
        Melanie Amaral
      </a>
    </div>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8 text-sm">
      {links.map(link => (
        <li>
          <a href={link.href} class="relative hover:text-white after:absolute after:left-0 after:-bottom-1 after:h-px after:w-0 after:bg-white hover:after:w-full after:transition-all">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile button -->
    <button
      id="menu-button"
      class="md:hidden flex flex-col gap-1.5"
      aria-label="Toggle menu"
    >
      <span class="w-6 h-px bg-white"></span>
      <span class="w-6 h-px bg-white"></span>
      <span class="w-6 h-px bg-white"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden max-h-0 opacity-0 -translate-y-2
          transition-all duration-300 ease-out
          bg-black/90 border-t border-white/10"
  >
    <ul class="flex flex-col px-6 py-6 space-y-4 text-sm">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class="block text-zinc-200 hover:text-white transition"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  let open = false;

  button?.addEventListener("click", () => {
    open = !open;

    menu?.classList.toggle("max-h-0", !open);
    menu?.classList.toggle("max-h-[300px]", open);
    menu?.classList.toggle("opacity-0", !open);
    menu?.classList.toggle("opacity-100", open);
    menu?.classList.toggle("-translate-y-2", !open);
    menu?.classList.toggle("translate-y-0", open);
  });

  menu?.querySelectorAll("a").forEach(link => {
  link.addEventListener("click", () => {
    open = false;
    menu.classList.add("max-h-0", "opacity-0", "-translate-y-2");
    menu.classList.remove("max-h-[300px]", "opacity-100", "translate-y-0");
  });
});

</script>

