---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

const { title, description, image, url } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      image={image}
      url={url}
    />
  </head>

  <body class="bg-white text-black max-w-8xl mx-auto p-6 font-sans">

    <!-- Header -->
    <header class="p-6 flex items-center justify-between">

      <!-- Logo -->
      <a href="/" class="text-xl font-semibold tracking-tight">
        Stephen Crowe
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex gap-8 text-sm font-medium">
        <a href="/" class="hover:opacity-60 transition">Work</a>
        <a href="/comics" class="hover:opacity-60 transition">Comics</a>
        <a href="/about" class="hover:opacity-60 transition">About</a>
      </nav>

      <!-- Mobile Menu Toggle -->
      <button id="mobile-button" class="md:hidden text-2xl" aria-label="Toggle Menu">
        ☰
      </button>

    </header>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden px-6 pb-6">
      <nav class="flex flex-col gap-4 text-sm font-medium">
        <a href="/" class="hover:opacity-60 transition">Work</a>
        <a href="/comics" class="hover:opacity-60 transition">Comics</a>
        <a href="/about" class="hover:opacity-60 transition">About</a>
      </nav>
    </div>

    <!-- Main Content -->
    <main class="max-w-8xl mx-auto p-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="p-6 flex flex-col md:flex-row justify-between items-center md:items-start gap-4 md:gap-0">
      <div class="text-center md:text-left text-sm opacity-70">
        © {new Date().getFullYear()} Stephen Crowe
      </div>
      <div class="text-center md:text-right text-sm opacity-70 flex gap-2">
        <a class="hover:opacity-60" href="https://invisibledot.substack.com/">Substack</a>•
        <a class="hover:opacity-60" href="https://www.instagram.com/invisibledot/">Instagram</a>•
        <a class="hover:opacity-60" href="https://www.linkedin.com/in/stephen-crowe-9945492b7/">LinkedIn</a>
      </div>
    </footer>

    <!-- Mobile Menu JS -->
    <script>
      const button = document.getElementById('mobile-button');
      const menu = document.getElementById('mobile-menu');

      button.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    </script>

  </body>
</html>