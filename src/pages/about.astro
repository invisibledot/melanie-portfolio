---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import Portrait from '../assets/mel-back-1.jpg';
---

<BaseLayout
  title="Melanie Amaral - About"
  description="Portfolio of Melanie Amaral — Commercial art and design."
  url="https://www.melanieamaral.com/about"
>

<h1 class="text-4xl font-bold mb-12">
  About/Contact
</h1>

<div class="flex flex-col-reverse md:flex-row items-start justify-center gap-8 md:gap-12">
  <div class="w-full md:w-1/3 flex-shrink-0">
    <Image 
      src={Portrait} 
      alt="A photograph of Melanie from behind." 
      class="w-full h-auto object-cover rounded-lg" 
    />
  </div>

  <div class="prose prose-lg prose-slate max-w-2xl w-full">
    <p>
      Melanie Amaral is an artist and designer with over nine years of experience in commercial art consulting.
    </p>
    <p>
      As lead digital artist for Grand Image, she has quoted, produced, and oversaw large-budget commissions in a variety of formats, such as wall covering, mixed media, painting, and sculpture. She’s a versatile artist who is able to create art in a variety of styles, and at any scale – from small framed pieces to multi-story murals. She has created work for a wide range of prestigious clients, including Google, Disney, Hilton, American Campus, Anthropologie, and Caesar’s Palace.
    </p>
    <p>
      In her spare time she enjoys hiking, traveling, drawing comic books with her husband, and searching fruitlessly for the perfect cardigan.
    </p>
    <p>
      <a href="mailto:melanieamaral@gmail.com">melanieamaral@gmail.com</a>
    </p>
  </div>
</div>

</BaseLayout>