---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Nav from "../components/Navbar.astro"

const { title, description, image, url } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- SEO -->
    <SEO title="Melanie Amaral" description="Portfolio of Melanie Amaral — Commercial art and design" image={image} url="https://www.melanieamaral.com" />
  </head>

  <body class="bg-white text-black max-w-7xl mx-auto p-6 font-sans">


    <!-- Main Content -->
    <main class="max-w-8xl mx-auto p-6">
      <h1 class="text-4xl font-bold mb-12 text-center">
        Melanie Amaral
      </h1>
    </main>

  </body>
</html>