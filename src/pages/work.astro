---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<BaseLayout
  title="Melanie Amaral, Artist & Illustrator"
  description="Portfolio of Melanie Amaral — Commercial art and design"
  url="https://www.melanieamaral.com"
>

<h1 class="text-4xl font-bold mb-12">
Commercial art and design
</h1>

<div class="columns-1 md:columns-2 gap-10">

{projects.map((project) => (
  <ProjectCard
    title={project.data.title}
    cover={project.data.cover}
    slug={project.slug}
  />
))}

</div>

</BaseLayout>